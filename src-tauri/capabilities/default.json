{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/erikeppinger/support-optimizer*" },
        { "url": "https://erikeppinger.github.io/support-optimizer/*" }
      ]
    }
  ]
}
